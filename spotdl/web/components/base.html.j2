<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <title>spotdl</title>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Import Datastar -->
    <!-- <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@main/bundles/datastar.js"></script> -->
    <script type="module" src="/assets/datastar.js"></script>

    <!-- Import DaisyUI -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" /> -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" /> -->
    <link href="/assets/daisyui@5.css" rel="stylesheet" type="text/css" />
    <link href="/assets/themes.css" rel="stylesheet" type="text/css" />

    <!-- Import tailwindcss -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> -->
    <script src="/assets/tailwindcss/browser@4.js"></script>

    <!-- Import Iconify -->
    <!-- <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script> -->
    <script src="/assets/iconify-icon/iconify-icon.min.js"></script>
</head>

<style>
    iconify-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
    }
    body[data-theme="night"] {
        background:
            radial-gradient(ellipse at 15% 10%, rgba(124, 58, 237, .24), transparent 38%),
            radial-gradient(ellipse at 85% 20%, rgba(6, 182, 212, .18), transparent 34%),
            #080b16;
        background-attachment: fixed;
    }
    [data-theme="night"] .navbar,
    [data-theme="night"] .card,
    [data-theme="night"] .modal-box,
    [data-theme="night"] .alert {
        border: 1px solid rgba(148, 163, 184, .18);
        background-color: rgba(17, 24, 39, .76);
        backdrop-filter: blur(18px);
        box-shadow: 0 18px 50px rgba(0, 0, 0, .24);
    }
    [data-theme="night"] .hero {
        background: transparent;
    }
    [data-theme="night"] .btn-primary {
        background-image: linear-gradient(115deg, #7c3aed, #0891b2);
        border: 0;
    }
</style>

<script>
    function toggleSpotdlTheme() {
        const nextTheme = document.body.dataset.theme === "night" ? "forest" : "night";
        document.body.dataset.theme = nextTheme;
        localStorage.setItem("spotdl-theme", nextTheme);
    }


    async function downloadQueuedFile(button, clientId) {
        const originalTitle = button.title || "Download file";
        const feedback = document.getElementById("download-feedback");
        button.disabled = true;
        button.classList.add("loading");
        const showFeedback = (message, isError = false) => {
            if (!feedback) return;
            feedback.textContent = message;
            feedback.className = isError
                ? "alert alert-error shadow-lg fixed top-20 right-4 z-50 max-w-md"
                : "alert alert-success shadow-lg fixed top-20 right-4 z-50 max-w-md";
            feedback.hidden = false;
        };
        try {
            const params = new URLSearchParams({
                file: button.dataset.filePath || "",
                client_id: clientId || ""
            });
            const response = await fetch("/api/download/file?" + params.toString(), {
                method: "GET",
                headers: { "Accept": "application/octet-stream, application/json" }
            });
            if (!response.ok) {
                let detail = "HTTP " + response.status;
                try {
                    const payload = await response.json();
                    detail = payload.detail || detail;
                } catch (_) {
                    const body = await response.text().catch(() => "");
                    if (body) detail = body.slice(0, 300);
                }
                throw new Error(detail);
            }
            const blob = await response.blob();
            if (!blob.size) throw new Error("The server returned an empty file.");
            const disposition = response.headers.get("Content-Disposition") || "";
            const match = disposition.match(/filename[^=]*=(?:UTF-8''|")?([^;"]+)/i);
            const filename = match ? decodeURIComponent(match[1].replace(/^"|"$/g, "")) : "download";
            const objectUrl = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = objectUrl;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(objectUrl);
            showFeedback("Download started: " + filename);
        } catch (error) {
            console.error("Queued file download failed:", error);
            showFeedback("Download failed: " + (error.message || "Unknown error"), true);
            button.title = "Download failed: " + (error.message || "Unknown error");
            button.classList.add("text-error");
        } finally {
            button.disabled = false;
            button.classList.remove("loading");
            if (!button.classList.contains("text-error")) button.title = originalTitle;
        }
    }

    function goto(location) {
        window.location.href = location;
    }
</script>

<body data-signals="{'client_id': ''}"
    data-on-load="$client_id = localStorage.getItem('client_id'); @get('/client/load')" data-theme="forest">

    <script>
        const savedSpotdlTheme = localStorage.getItem("spotdl-theme");
        if (savedSpotdlTheme === "night" || savedSpotdlTheme === "forest") {
            document.body.dataset.theme = savedSpotdlTheme;
        }
    </script>

    <div class="bg-base-300 absolute w-full t-0">
        {% include "navbar.html.j2" %}\n        <div id="download-feedback" hidden aria-live="polite"></div>

        <!-- Content -->
        {% block content %}
        {% endblock content %}

        <!-- DEBUG: Display all signals -->


        {#
        <pre data-json-signals></pre> #}


        <!-- Footer -->
        {% include "footer.html.j2" %}

        <!-- Settings -->
        <span id="component-settings"
            data-on-signal-patch="@get('/client/component/settings-content'); localStorage.setItem('client_id', $client_id);"
            data-on-signal-patch-filter="{include: /client_id/}">
        </span>
        <dialog id="settings_modal" class="modal">
            <!-- Settings Modal Content -->
            <div id="component-settings-content"></div>
            <form method="dialog" class="modal-backdrop">
                <button>close</button>
            </form>
        </dialog>

    </div>

</body>

</html>