<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <title>spotdl</title>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Import Datastar -->
    <!-- <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@main/bundles/datastar.js"></script> -->
    <script type="module" src="/assets/datastar.js"></script>

    <!-- Import DaisyUI -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" /> -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" /> -->
    <link href="/assets/daisyui@5.css" rel="stylesheet" type="text/css" />
    <link href="/assets/themes.css" rel="stylesheet" type="text/css" />

    <!-- Import tailwindcss -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> -->
    <script src="/assets/tailwindcss/browser@4.js"></script>

    <!-- Import Iconify -->
    <!-- <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script> -->
    <script src="/assets/iconify-icon/iconify-icon.min.js"></script>
</head>

<style>
    iconify-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
    }
    [data-theme="night"] body {
        background:
            radial-gradient(ellipse at 15% 10%, rgba(124, 58, 237, .24), transparent 38%),
            radial-gradient(ellipse at 85% 20%, rgba(6, 182, 212, .18), transparent 34%),
            #080b16;
        background-attachment: fixed;
    }
    [data-theme="night"] .navbar,
    [data-theme="night"] .card,
    [data-theme="night"] .modal-box,
    [data-theme="night"] .alert {
        border: 1px solid rgba(148, 163, 184, .18);
        background-color: rgba(17, 24, 39, .76);
        backdrop-filter: blur(18px);
        box-shadow: 0 18px 50px rgba(0, 0, 0, .24);
    }
    [data-theme="night"] .hero {
        background: transparent;
    }
    [data-theme="night"] .btn-primary {
        background-image: linear-gradient(115deg, #7c3aed, #0891b2);
        border: 0;
    }
</style>

<script>
    function toggleSpotdlTheme() {
        const nextTheme = document.body.dataset.theme === "night" ? "forest" : "night";
        document.body.dataset.theme = nextTheme;
        localStorage.setItem("spotdl-theme", nextTheme);
    }

    function goto(location) {
        window.location.href = location;
    }
</script>

<body data-signals="{'client_id': ''}"
    data-on-load="$client_id = localStorage.getItem('client_id'); @get('/client/load')" data-theme="forest">

    <script>
        const savedSpotdlTheme = localStorage.getItem("spotdl-theme");
        if (savedSpotdlTheme === "night" || savedSpotdlTheme === "forest") {
            document.body.dataset.theme = savedSpotdlTheme;
        }
    </script>

    <div class="bg-base-300 absolute w-full t-0">
        {% include "navbar.html.j2" %}

        <!-- Content -->
        {% block content %}
        {% endblock content %}

        <!-- DEBUG: Display all signals -->


        {#
        <pre data-json-signals></pre> #}


        <!-- Footer -->
        {% include "footer.html.j2" %}

        <!-- Settings -->
        <span id="component-settings"
            data-on-signal-patch="@get('/client/component/settings-content'); localStorage.setItem('client_id', $client_id);"
            data-on-signal-patch-filter="{include: /client_id/}">
        </span>
        <dialog id="settings_modal" class="modal">
            <!-- Settings Modal Content -->
            <div id="component-settings-content"></div>
            <form method="dialog" class="modal-backdrop">
                <button>close</button>
            </form>
        </dialog>

    </div>

</body>

</html>